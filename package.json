    "lodash": "^4.17.21",
    "naive-ui": "^2.43.2",
    "pinia": "^3.0.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vue": "^3.5.26",
    "vue-component-type-helpers": "^3.2.1",
